# AI Bajan admin — frontend-safe configuration only.
# Anything prefixed VITE_ is bundled into public JavaScript. NEVER put Supabase service-role keys,
# OpenAI keys, database credentials or any other secret here.

# "mock" (default): all data comes from the in-browser demo services, persisted to localStorage.
# "live": reserved for the future Node.js API. Services are not wired to it yet (see README).
VITE_DATA_MODE=mock

# Future Node.js API base URL (example for local development only).
VITE_API_BASE_URL=http://localhost:5000/api

# Public website URL, used for "View on site" / preview links.
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Simulated failure rate for mock write operations (0 – 1). Useful for testing error states.
VITE_MOCK_FAILURE_RATE=0
