# AI Bajan admin — frontend-safe configuration only.
# Anything prefixed VITE_ is bundled into public JavaScript. NEVER put Supabase service-role keys,
# OpenAI keys, database credentials or any other secret here.

# "live": every page uses the AI Bajan API. "mock": in-browser demo data (no backend).
VITE_DATA_MODE=live

# AI Bajan API root (must end with /api/v1).
VITE_API_BASE_URL=https://ai-bajan-tourism-directory-server.vercel.app/api/v1

# Supabase Auth for administrator sign-in. The publishable (anon) key is public by design.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public website URL, used for "View on site" / preview links.
VITE_PUBLIC_SITE_URL=https://ai-bajan-tourism-directory.vercel.app

# Mock mode only: simulated failure rate for write operations (0 – 1).
VITE_MOCK_FAILURE_RATE=0
