# Data source for the public site.
#   "mock" (default) — uses the bundled demo data in src/data. Clearly labelled demo mode.
#   "live"           — calls the Node.js API at VITE_API_BASE_URL. No silent fallback to mock data.
VITE_DATA_MODE=mock

# Base URL of the future AI Bajan Node.js API (only used when VITE_DATA_MODE=live).
# Example for local development only — set the real URL per environment in Vercel.
VITE_API_BASE_URL=https://ai-bajan-tourism-directory-server.vercel.app/api/v1

# Public site origin, used for canonical URLs and Open Graph tags.
VITE_SITE_URL=https://ai-bajan-tourism-directory.vercel.app

# Optional public social profile URLs. Links are hidden in the footer unless set.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_X=

# Never put secret keys (OpenAI, database, etc.) in VITE_ variables — they are bundled into public JavaScript.

# Optional: map tile provider for Leaflet maps. Defaults to OpenStreetMap's public tiles,
# which are fine for development but not for heavy production traffic (see the OSM tile policy).
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
