# AI Bajan API — copy to .env and fill in. NEVER commit .env.
# Every variable below is SERVER-ONLY. Do not copy any of them into the React apps (client/ or admin/).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS (public site + admin dashboard)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY=0

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable/anon key: used server-side only to verify user access tokens with Supabase Auth.
SUPABASE_ANON_KEY=
# Service-role key: not required by the API (it connects to Postgres directly). Leave empty unless needed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (Supabase pooler) ----------------------------------------------
DATABASE_HOST=aws-0-region.pooler.supabase.com
# Transaction pooler port, used by the API and worker
DATABASE_PORT=6543
# Session pooler port, used only by migration / inventory scripts (DDL)
DATABASE_MIGRATION_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres.your-project-ref
DATABASE_PASSWORD=
# Optional: path to the Supabase CA certificate to verify TLS (recommended in production)
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
# public in production; website_with_rag_test is the isolated schema used by integration tests
DB_SCHEMA=public

# --- OpenAI -------------------------------------------------------------------
# Without a key the chatbot still works: keyword + structured retrieval and extractive answers.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the model's output AND the vector column (migration 0001). text-embedding-3-small = 1536.
EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=700
LLM_MAX_CONCURRENCY=4

# --- Sessions & rate limits ----------------------------------------------------
# Random string, at least 32 characters. Signs anonymous chat visitor tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
CHAT_RATE_LIMIT_MAX=20
FEEDBACK_RATE_LIMIT_MAX=10

# --- Retrieval (see README "Retrieval configuration") ------------------------
RETRIEVAL_CANDIDATE_LIMIT=30
RETRIEVAL_CONTEXT_LIMIT=8
RETRIEVAL_KEYWORD_WEIGHT=1
RETRIEVAL_SEMANTIC_WEIGHT=1
RETRIEVAL_MIN_SIMILARITY=0.25
RETRIEVAL_MAX_CONTEXT_CHARS=9000
RETRIEVAL_TIMEOUT_MS=8000
MEMORY_TURNS=6
CONVERSATION_TTL_DAYS=30
RETRIEVAL_LOG_RETENTION_DAYS=30

# --- Background worker -----------------------------------------------------------
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_SECONDS=120
# true = run the sync worker inside the API process (single small instance only)
RUN_WORKER_IN_PROCESS=false
