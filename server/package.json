{
  "name": "ai-bajan-server",
  "version": "1.0.0",
  "private": true,
  "description": "AI Bajan backend API and RAG chatbot",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "worker": "tsx src/jobs/worker.ts",
    "worker:prod": "node dist/src/jobs/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:inventory": "node scripts/inventory.mjs",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:verify": "tsx src/database/verify.ts",
    "db:seed:reference": "tsx supabase/seed/seedReference.ts",
    "admin:grant": "tsx scripts/grantAdmin.ts",
    "eval:rag": "tsx tests/evaluation/runEvaluation.ts",
    "knowledge:import": "tsx scripts/importKnowledge.ts",
    "knowledge:crawl": "tsx scripts/crawlSites.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "openai": "^7.32.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "playwright-core": "^1.64.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
